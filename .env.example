# All optional — the journal boots with none of these set.

# Require a password to open the journal (recommended when exposed beyond localhost).
# JOURNAL_PASSWORD=

# Encryption key source for broker credentials at rest.
# Default: a random key file generated next to the database.
# JOURNAL_SECRET=

# Where the SQLite database lives. Default: ./data
# JOURNAL_DATA_DIR=

# AI features (session recaps, trade critiques, ask-your-journal).
# Can also be set on the Settings page (stored encrypted).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# If only OPENAI_API_KEY or OPENAI_BASE_URL is set, OpenAI is selected automatically.
# If both keys are set, Anthropic stays the default until you choose a provider in Settings.
# Provider, model, and optional OpenAI-compatible base URL are saved in Settings.
# Environment keys and OPENAI_BASE_URL take precedence over saved values.
# Example local server: OPENAI_BASE_URL=http://127.0.0.1:1234/v1

# Optional market data: no provider is configured or enabled by this template.
# Choose a connection or upload candle CSVs in Settings > Market data.
# Provider-specific environment configuration is documented in docs/market-data.md.
